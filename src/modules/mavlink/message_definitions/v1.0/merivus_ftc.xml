      <field type="uint8_t" name="recovery_state" enum="MERIVUS_FTC_RECOVERY_STATE">Recovery-candidate state.</field>
      <field type="uint8_t" name="flags" enum="MERIVUS_FTC_CONTROL_FLAGS">Validity and integration flags.</field>
      <field type="uint8_t" name="roll_authority_pct">Remaining roll authority.</field>
      <field type="uint8_t" name="pitch_authority_pct">Remaining pitch authority.</field>
