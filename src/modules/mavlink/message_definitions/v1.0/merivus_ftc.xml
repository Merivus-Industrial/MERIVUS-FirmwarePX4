      <field type="uint64_t" name="time_usec" units="us">PX4 monotonic publication timestamp.</field>
      <field type="uint64_t" name="event_time_usec" units="us">Most recent extreme-event timestamp.</field>
      <field type="uint32_t" name="loss_of_control_reason_mask">Loss-of-control reason bit mask.</field>
      <field type="uint32_t" name="recovery_trigger_mask">Recovery-candidate trigger bit mask.</field>
      <field type="uint32_t" name="recovery_inhibit_mask">Recovery-candidate inhibit bit mask.</field>
      <field type="uint8_t" name="protocol_version">MERIVUS FTC telemetry contract version.</field>
      <field type="uint8_t" name="impact_type" enum="MERIVUS_FTC_IMPACT_TYPE">Observed impact type.</field>
      <field type="uint8_t" name="loc_state" enum="MERIVUS_FTC_LOC_STATE">Loss-of-control state.</field>
      <field type="uint8_t" name="recovery_state" enum="MERIVUS_FTC_RECOVERY_STATE">Recovery-candidate state.</field>
      <field type="uint8_t" name="flags" enum="MERIVUS_FTC_EXTREME_FLAGS">Validity and event flags.</field>
      <field type="uint8_t" name="impact_score_pct">Impact score.</field>
      <field type="uint8_t" name="impact_confidence_pct">Impact confidence.</field>
      <field type="uint8_t" name="impact_severity_pct">Impact severity.</field>
      <field type="uint8_t" name="loss_of_control_score_pct">Loss-of-control score.</field>
      <field type="uint8_t" name="recovery_progress_pct">Recovery-candidate state progress.</field>
    </message>
    <message id="60003" name="MERIVUS_FTC_DIAGNOSTICS">
      <description>Low-rate FTC engineering diagnostics. These fields are not required for the primary operator view.</description>
      <field type="uint64_t" name="time_usec" units="us">PX4 monotonic publication timestamp.</field>
      <field type="float" name="model_residual">Motor observer model residual.</field>
      <field type="float" name="excitation">Observer excitation score.</field>
      <field type="float" name="maneuver_intensity">Observed maneuver intensity.</field>
      <field type="float" name="external_disturbance_score">Observed external-disturbance score.</field>
      <field type="float" name="vibration_score">Observed vibration score.</field>
      <field type="float" name="allocation_residual_norm">Shadow allocation residual norm.</field>
      <field type="float" name="attitude_error" units="rad">Attitude error magnitude.</field>
      <field type="float" name="rate_error" units="rad/s">Angular-rate error magnitude.</field>
      <field type="float" name="jerk">Jerk magnitude.</field>
      <field type="float" name="acceleration_magnitude">Acceleration magnitude.</field>
      <field type="float" name="angular_rate" units="rad/s">Angular-rate magnitude.</field>
      <field type="float" name="angular_acceleration">Angular-acceleration magnitude.</field>
      <field type="uint32_t" name="system_reason_mask">Aggregated FTC reason bit mask.</field>
      <field type="uint8_t" name="protocol_version">MERIVUS FTC telemetry contract version.</field>
      <field type="uint8_t" name="flags" enum="MERIVUS_FTC_DIAGNOSTIC_FLAGS">Diagnostic validity and simulation flags.</field>
      <field type="uint8_t" name="simulation_motor_index">Injected SITL motor index.</field>
      <field type="uint8_t" name="simulation_target_effectiveness_pct">Requested SITL effectiveness using the compact percentage scaling.</field>
      <field type="uint8_t" name="simulation_applied_effectiveness_pct">Applied SITL effectiveness using the compact percentage scaling.</field>
      <extensions/>
      <field type="float" name="condition_number">Regressor information matrix condition number.</field>
      <field type="float" name="rigid_body_activity">Inertia based torque activity norm, not a prediction error.</field>
      <field type="float" name="model_prediction_residual">Norm of predicted minus measured filtered angular response.</field>
      <field type="uint32_t" name="update_count">Accepted parameter updates.</field>
      <field type="uint32_t" name="reset_count">Estimator reset generation.</field>
      <field type="float" name="mass">Observe-only mass in kg; unavailable without calibrated thrust scale.</field>
      <field type="float[3]" name="inertia">Configured inertia; never an online valid estimate unless indicated.</field>
      <field type="float[3]" name="cg_offset">Observe-only CG in metres; NaN when not estimated.</field>
      <field type="uint8_t" name="mass_state">0 not implemented, 1 not observable, 2 available.</field>
      <field type="uint8_t" name="inertia_state">0 not implemented, 1 not observable, 2 available.</field>
      <field type="uint8_t" name="cg_state">0 not implemented, 1 not observable, 2 available.</field>
      <field type="uint8_t" name="estimator_flags">Bit 0 update allowed, 1 saturated, 2 authority limited, 3 timing aligned.</field>
    </message>
