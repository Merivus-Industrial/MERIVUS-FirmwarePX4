  <messages>
    <message id="60000" name="MERIVUS_FTC_MOTOR_STATUS">
      <description>Compact per-motor FTC observer output for operator interfaces. Percentage arrays use 0..200 for 0..100 percent in 0.5 percent steps; 255 means unavailable.</description>
      <field type="uint64_t" name="time_usec" units="us">PX4 monotonic publication timestamp.</field>
      <field type="uint16_t" name="degraded_mask">Bit i is set when motor i is degraded.</field>
      <field type="uint16_t" name="failed_mask">Bit i is set when motor i is failed.</field>
      <field type="uint8_t[12]" name="health_pct">Observed health score. This is not remaining life.</field>
      <field type="uint8_t[12]" name="effectiveness_pct">Observed relative actuator effectiveness.</field>
      <field type="uint8_t[12]" name="fault_probability_pct">Observed fault probability.</field>
      <field type="uint8_t[12]" name="confidence_pct">Observer confidence.</field>
      <field type="uint8_t[12]" name="fault_type" enum="MERIVUS_FTC_FAULT_TYPE">Observed fault classification.</field>
      <field type="uint8_t" name="protocol_version">MERIVUS FTC telemetry contract version.</field>
      <field type="uint8_t" name="system_state" enum="MERIVUS_FTC_SYSTEM_STATE">Aggregated subsystem state.</field>
      <field type="uint8_t" name="monitor_state" enum="MERIVUS_FTC_MONITOR_STATE">Motor-health observer state.</field>
      <field type="uint8_t" name="motor_count">Number of valid motor entries, maximum 12.</field>
      <field type="uint8_t" name="flags" enum="MERIVUS_FTC_MOTOR_FLAGS">Validity and source flags.</field>
      <field type="uint8_t" name="model_quality_pct">Rigid-body model quality using the percentage scaling above.</field>
      <extensions/>
      <field type="uint64_t" name="last_valid_timestamp">Last accepted valid parameter update timestamp in microseconds.</field>
      <field type="float" name="estimate_age">Seconds since last parameter update; infinity before first update.</field>
      <field type="float[12]" name="estimate_uncertainty">One sigma relative-effectiveness uncertainty.</field>
      <field type="uint8_t[12]" name="diagnosis_state">0 no evidence, 1 unknown, 2 unobservable, 3 valid healthy, 4 degraded, 5 failed.</field>
      <field type="uint8_t" name="estimator_state">0 uninitialized, 1 calibrating, 2 baseline learned, 3 observable, 4 temporarily unobservable, 5 valid, 6 stale, 7 invalid.</field>
      <field type="uint8_t" name="baseline_learned">Healthy baseline was learned this session.</field>
      <field type="uint8_t" name="current_observable">Current aligned sample supplies independent information.</field>
    </message>
    <message id="60001" name="MERIVUS_FTC_CONTROL_STATUS">
      <description>Control-authority and integration-stage summary. Percentage fields use 0..200 for 0..100 percent in 0.5 percent steps; 255 means unavailable.</description>
      <field type="uint64_t" name="time_usec" units="us">PX4 monotonic publication timestamp.</field>
      <field type="uint16_t" name="saturated_mask">Actuator saturation bit mask.</field>
      <field type="uint8_t" name="protocol_version">MERIVUS FTC telemetry contract version.</field>
      <field type="uint8_t" name="system_state" enum="MERIVUS_FTC_SYSTEM_STATE">Aggregated subsystem state.</field>
      <field type="uint8_t" name="authority_state" enum="MERIVUS_FTC_AUTHORITY_STATE">Remaining control-authority state.</field>
