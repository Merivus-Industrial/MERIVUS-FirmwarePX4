      <field type="uint8_t" name="actuator_headroom_pct">Remaining actuator headroom.</field>
      <field type="uint8_t" name="system_confidence_pct">Aggregated FTC confidence.</field>
      <field type="uint8_t" name="recovery_progress_pct">Recovery-candidate state progress.</field>
      <extensions/>
      <field type="float[3]" name="positive_authority">Positive roll pitch yaw reachable increments in nominal matrix units.</field>
      <field type="float[3]" name="negative_authority">Negative roll pitch yaw reachable increments in nominal matrix units.</field>
      <field type="float" name="thrust_up">Reachable upward thrust increment.</field>
      <field type="float" name="thrust_down">Reachable downward thrust increment.</field>
      <field type="float" name="reachable_residual">Shadow allocation prediction residual norm.</field>
      <field type="uint32_t" name="allocation_fallback">Active allocator fallback reason mask.</field>
      <field type="uint32_t" name="recovery_fallback">Recovery arbitration fallback reason mask.</field>
      <field type="float" name="arbitration_weight">Actual recovery input ownership weight.</field>
      <field type="float" name="reentry_weight">Requested recovery ownership during reentry.</field>
      <field type="uint8_t" name="allocation_active">Dynamic matrix differs from nominal.</field>
      <field type="uint8_t" name="recovery_active">Recovery input arbitration is applied.</field>
    </message>
    <message id="60002" name="MERIVUS_FTC_EXTREME_STATUS">
